{
  "name": "@metabob/discovery-vessel",
  "version": "0.3.0",
  "description": "Discovery vessel - resolves vesselCapability, vesselEndpoint, vesselHealth impulses",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "discovery-vessel": "./index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=external && tsc --emitDeclarationOnly",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vessel",
    "discovery",
    "impulse",
    "metabob"
  ],
  "license": "MIT",
  "author": "Metabob <team@metabob.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/discovery-vessel.git"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
